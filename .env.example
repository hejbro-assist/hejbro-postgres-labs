# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 git이 무시한다.
#   cp .env.example .env && chmod 600 .env
# 값에는 반드시 sslmode=require를 포함한다 (postgres 로컬 타깃 제외).

# Neon: 콘솔의 "direct" (non-pooled) 접속 문자열. pooled(-pooler) 엔드포인트는
# transaction 모드라 migrate에 쓰지 않는다.
NEON_DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Nile: 콘솔의 표준 5432 접속 문자열.
NILE_DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# Supabase: direct 접속 또는 session-mode pooler(5432). transaction-mode(6543)는 쓰지 않는다.
SUPABASE_DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require

# 로컬 Postgres 18 (pnpm local-pg up). 로컬 전용 기본값이라 실제 값을 적어 둔다.
POSTGRES_DATABASE_URL=postgres://postgres:postgres@localhost:54329/hejbro_lab
